---
import SiteLayout from "../layouts/SiteLayout.astro";
const { title, description, canonical, intro, approach, uses, considerations } = Astro.props;
---
<SiteLayout title={title + " | Paver Blocks Pakistan"} description={description} canonical={canonical}>
  <section class="page-hero">
    <p class="eyebrow">Paver Blocks / Services</p>
    <h1>{title}.</h1>
    <p>{description}</p>
  </section>
  <section class="content-section">
    <p class="eyebrow">Service overview</p>
    <h2>Understand the site before defining the work.</h2>
    <p>{intro}</p>
    <p>{approach}</p>
  </section>
  <section class="content-section soft-section">
    <p class="eyebrow">Typical project settings</p>
    <h2>Where this work may be considered</h2>
    <div class="card-grid">
      {uses.map((use) => <article class="info-card"><h3>{use}</h3><p>The right method and materials depend on the actual site, intended use and agreed scope.</p></article>)}
    </div>
  </section>
  <section class="content-section">
    <p class="eyebrow">Before requesting a quote</p>
    <h2>Useful details to share</h2>
    <ul class="detail-list">
      {considerations.map((item) => <li>{item}</li>)}
    </ul>
    <p>Every site is different. Final recommendations and quotation details can be discussed after reviewing the information you provide.</p>
    <div class="actions">
      <a class="button button-primary" href="/get-a-quote/">Request a Quote</a>
      <a class="button" href="https://wa.me/923162753210">WhatsApp Us</a>
      <a class="button" href="/services/">View All Services</a>
    </div>
  </section>
</SiteLayout>
<style>
.detail-list{max-width:760px;padding-left:22px;color:#526176}
.detail-list li{padding:7px 0}
</style>

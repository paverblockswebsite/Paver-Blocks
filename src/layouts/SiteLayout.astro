---
const {
  title = "Paver Blocks | Paving & Civil Construction in Pakistan",
  description = "Professional paver block installation, road paving and civil construction services across Pakistan. Based in Hyderabad, Sindh.",
  canonical = "https://paverblocks.com.pk/",
  ogImage = "/images/OG Premium Paver Blocks Brand Banner.png",
  noindex = false
} = Astro.props;
const productionOrigin = "https://paverblocks.com.pk";
const canonicalUrl = new URL(canonical, productionOrigin).toString();
const ogImageUrl = new URL(ogImage, productionOrigin).toString();
const deploymentBranch = (import.meta as any).env?.CF_PAGES_BRANCH || "main";
const isPreviewDeployment = deploymentBranch !== "main";
const nav = [
  { label: "About", href: "/about/" },
  { label: "Services", href: "/services/" },
  { label: "Paver Designs", href: "/paver-designs/" },
  { label: "Projects", href: "/projects/" },
  { label: "FAQs", href: "/faqs/" },
  { label: "Contact", href: "/contact/" }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#172B45" />
    <meta name="robots" content={isPreviewDeployment || noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Paver Blocks" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="941" />
    <meta property="og:image:alt" content="Paver Blocks: Building Strong Foundations. Creating Lasting Roads." />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "GeneralContractor",
      "name": "Paver Blocks",
      "description": "Paver block installation, road paving and related civil construction services.",
      "url": "https://paverblocks.com.pk/",
      "email": "hellopaverblocks@gmail.com",
      "telephone": "+923162753210",
      "founder": { "@type": "Person", "name": "Mithal Shahan" },
      "areaServed": { "@type": "Country", "name": "Pakistan" },
      "address": { "@type": "PostalAddress", "addressLocality": "Hyderabad", "addressRegion": "Sindh", "addressCountry": "PK" }
    })} />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><span></span></div>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Paver Blocks home">
        <img class="brand-logo" src="/images/brand/paver-blocks-primary-horizontal.png" alt="Paver Blocks" width="220" height="67" fetchpriority="high" />
      </a>
      <button class="mobile-menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-navigation">
        <span></span><span></span><span></span>
      </button>
      <nav id="primary-navigation" aria-label="Main navigation">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="/get-a-quote/" class="nav-cta">Get a Quote</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand"><img class="footer-brand-logo" src="/images/brand/paver-blocks-wordmark.png" alt="Paver Blocks" width="150" height="92" loading="lazy" /><p>By Mithal Shahan — Civil Contractor</p><div class="footer-contact"><a href="tel:+923162753210">+92 316 2753210</a><a href="mailto:hellopaverblocks@gmail.com">hellopaverblocks@gmail.com</a><span>Hyderabad, Sindh · Serving Pakistan</span></div></div>
      <div class="footer-links"><a href="/services/">Services</a><a href="/projects/">Projects</a><a href="/paver-designs/">Paver Designs</a><a href="/faqs/">FAQs</a><a href="/contact/">Contact</a><a href="/privacy-policy/">Privacy Policy</a><a href="/cookie-policy/">Cookie Policy</a><a href="/terms-and-conditions/">Terms &amp; Conditions</a></div>
    </footer>
    <script>
      // Accessible responsive navigation: the menu is collapsed on small screens.
      const menuToggle = document.querySelector(".mobile-menu-toggle");
      const primaryNavigation = document.querySelector("#primary-navigation");
      const closeMobileMenu = () => {
        if (!menuToggle || !primaryNavigation) return;
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open navigation menu");
        primaryNavigation.classList.remove("is-open");
      };
      menuToggle?.addEventListener("click", () => {
        const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!isOpen));
        menuToggle.setAttribute("aria-label", isOpen ? "Open navigation menu" : "Close navigation menu");
        primaryNavigation?.classList.toggle("is-open", !isOpen);
      });
      primaryNavigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMobileMenu));
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeMobileMenu();
      });
      window.matchMedia("(min-width: 761px)").addEventListener("change", closeMobileMenu);

      // Phase 1: progressively enhance content already present in the page.
      const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
      const prefersMotion = !motionPreference.matches;
      const main = document.querySelector("main");

      if (main && prefersMotion && "IntersectionObserver" in window) {
        main.querySelectorAll(":scope > section:not(.hero):not(.page-hero)").forEach((section) => {
          section.setAttribute("data-motion", "reveal");
        });
        main.querySelectorAll(".card-grid,.paver-design-grid,.design-grid,.faq-list,.profile-feature,.story-steps,.showcase-track").forEach((grid) => {
          grid.setAttribute("data-motion", "stagger");
        });
        // Keep every source image visible; animate its surrounding section/card instead.
        main.querySelectorAll(".info-card,.paver-design-card,.design-card,.faq-item,.story-step,.showcase-card").forEach((card) => {
          card.classList.add("motion-hover-lift");
        });

        const motionTargets = main.querySelectorAll('[data-motion="reveal"], [data-motion="stagger"]');
        if (motionTargets.length) {
          document.documentElement.classList.add("motion-ready");
          const revealObserver = new IntersectionObserver((entries, observer) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("motion-visible");
              observer.unobserve(entry.target);
            }
          }, { root: null, rootMargin: "0px 0px -48px 0px", threshold: 0.12 });

          motionTargets.forEach((target) => {
            if (target.dataset.motion === "stagger") {
              Array.from(target.children).forEach((child, index) => {
                child.classList.add("motion-stagger-item");
                child.style.setProperty("--motion-stagger-index", String(Math.min(index, 8)));
                if (target.classList.contains("profile-feature")) child.classList.add("motion-profile-item");
                if (target.classList.contains("story-steps")) child.classList.add("motion-story-item");
                if (target.classList.contains("showcase-track")) child.classList.add("motion-showcase-item");
              });
            }
            revealObserver.observe(target);
          });
        }
      }

      // Lightweight scroll progress indicator, updated at most once per animation frame.
      const progressBar = document.querySelector(".scroll-progress > span");
      let progressFrame = 0;
      const updateScrollProgress = () => {
        progressFrame = 0;
        if (!progressBar) return;
        const scrollable = document.documentElement.scrollHeight - window.innerHeight;
        const progress = scrollable > 0 ? window.scrollY / scrollable : 0;
        progressBar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
      };
      window.addEventListener("scroll", () => {
        if (!progressFrame) progressFrame = window.requestAnimationFrame(updateScrollProgress);
      }, { passive: true });
      window.addEventListener("resize", updateScrollProgress, { passive: true });
      updateScrollProgress();

      // Phase 5: magnetic feedback, click ripples, text scramble and desktop pointer follower.
      const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (finePointer.matches && !reduceMotion.matches) {
        document.querySelectorAll('.button, .nav-cta').forEach((button) => {
          button.classList.add('magnetic-button');
          button.addEventListener('pointermove', (event) => {
            const rect = button.getBoundingClientRect();
            const dx = event.clientX - (rect.left + rect.width / 2);
            const dy = event.clientY - (rect.top + rect.height / 2);
            button.style.setProperty('--mag-x', Math.max(-7, Math.min(7, dx * 0.12)) + 'px');
            button.style.setProperty('--mag-y', Math.max(-6, Math.min(6, dy * 0.12)) + 'px');
          });
          button.addEventListener('pointerleave', () => {
            button.style.setProperty('--mag-x', '0px');
            button.style.setProperty('--mag-y', '0px');
          });
        });
      }
      document.querySelectorAll('.button, .nav-cta').forEach((button) => {
        button.addEventListener('click', (event) => {
          if (reduceMotion.matches) return;
          const rect = button.getBoundingClientRect();
          const ripple = document.createElement('span');
          const diameter = Math.max(rect.width, rect.height) * 1.35;
          ripple.className = 'interaction-ripple';
          ripple.style.width = diameter + 'px';
          ripple.style.height = diameter + 'px';
          ripple.style.left = (event.clientX - rect.left - diameter / 2) + 'px';
          ripple.style.top = (event.clientY - rect.top - diameter / 2) + 'px';
          button.append(ripple);
          ripple.addEventListener('animationend', () => ripple.remove(), { once: true });
        });
      });

      const scrambleChars = '01アイウエオカキクケコサシスセソ';
      document.querySelectorAll('[data-scramble]').forEach((target) => {
        const original = target.textContent || '';
        if (!original.trim()) return;
        const reveal = () => {
          let frame = 0;
          const totalFrames = Math.max(18, original.length * 2);
          const tick = () => {
            const settled = Math.floor((frame / totalFrames) * original.length);
            target.textContent = Array.from(original).map((char, index) => {
              if (char === ' ' || index < settled) return char;
              return scrambleChars[Math.floor(Math.random() * scrambleChars.length)];
            }).join('');
            frame += 1;
            if (frame <= totalFrames) window.requestAnimationFrame(tick);
            else target.textContent = original;
          };
          tick();
        };
        if (reduceMotion.matches || !('IntersectionObserver' in window)) target.textContent = original;
        else {
          const scrambleObserver = new IntersectionObserver((entries, observer) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            reveal();
            observer.disconnect();
          }, { threshold: 0.7 });
          scrambleObserver.observe(target);
        }
      });

      if (finePointer.matches && !reduceMotion.matches) {
        const follower = document.createElement('span');
        follower.className = 'cursor-follower';
        follower.setAttribute('aria-hidden', 'true');
        document.body.append(follower);
        document.addEventListener('pointermove', (event) => {
          follower.style.transform = 'translate3d(' + event.clientX + 'px, ' + event.clientY + 'px, 0)';
          follower.classList.add('is-visible');
        }, { passive: true });
        document.addEventListener('pointerleave', () => follower.classList.remove('is-visible'));
        document.querySelectorAll('a, button, [role="button"]').forEach((item) => {
          item.addEventListener('pointerenter', () => follower.classList.add('is-hovering'));
          item.addEventListener('pointerleave', () => follower.classList.remove('is-hovering'));
        });
      }
    </script>
  </body>
</html>
<style is:global>
  :root{color-scheme:light;--navy:#172B45;--yellow:#F5C542;--ink:#172B45;--muted:#667386;--soft:#F4F6F8;--motion-duration-fast:160ms;--motion-duration-base:420ms;--motion-ease:cubic-bezier(.2,.7,.2,1)}
  /* Brand-coloured text selection across every page and selectable content. */
  ::selection{color:#172B45;background:#F5C542;text-shadow:none}
  ::-moz-selection{color:#172B45;background:#F5C542;text-shadow:none}
  *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:#fff;line-height:1.65}a{color:inherit;text-decoration:none}
  .scroll-progress{position:fixed;inset:0 0 auto;z-index:2000;height:3px;pointer-events:none;background:transparent}.scroll-progress span{display:block;width:100%;height:100%;background:var(--yellow);transform:scaleX(0);transform-origin:left center;will-change:transform}
  .skip-link{position:absolute;left:16px;top:-60px;z-index:2100;padding:10px 14px;border-radius:5px;color:#172B45;background:#F5C542;font-weight:800}.skip-link:focus{top:12px}
  a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #C18D00;outline-offset:3px;border-radius:3px}
  .site-header{position:relative;z-index:100;min-height:82px;padding:14px max(5vw,24px);display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #e8ebef;background:#fff}
  .brand{display:flex;align-items:center;flex-shrink:0}.brand-logo{display:block;width:220px;height:auto;max-height:58px;object-fit:contain;object-position:left center}.footer-brand-logo{display:block;width:150px;height:auto;max-height:92px;object-fit:contain;object-position:left center}.footer-brand p{margin-top:10px}
  nav{display:flex;align-items:center;gap:22px;font-size:14px;font-weight:700}nav a:hover,.site-footer a:hover{color:#b18408}.nav-cta,.button-primary{padding:10px 16px;color:var(--navy);background:var(--yellow);border-radius:6px}
  .mobile-menu-toggle{display:none;width:44px;height:44px;padding:10px;border:1px solid #d9e0e7;border-radius:8px;background:#fff;color:var(--navy);cursor:pointer}
  .mobile-menu-toggle span{display:block;width:21px;height:2px;margin:4px auto;border-radius:2px;background:currentColor;transition:transform 180ms ease,opacity 180ms ease}
  .mobile-menu-toggle[aria-expanded="true"] span:first-child{transform:translateY(6px) rotate(45deg)}
  .mobile-menu-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}
  .mobile-menu-toggle[aria-expanded="true"] span:last-child{transform:translateY(-6px) rotate(-45deg)}
  .page-hero{padding:76px max(8vw,24px);color:#fff;background:radial-gradient(ellipse at 85% 10%,#294969 0,transparent 42%),var(--navy)}.eyebrow{margin:0 0 14px;color:#b18408;font-size:12px;font-weight:850;letter-spacing:.16em;text-transform:uppercase}.page-hero .eyebrow{color:var(--yellow)}h1,h2,h3,p{margin-top:0}h1{max-width:900px;margin-bottom:18px;font-size:clamp(40px,5.6vw,68px);line-height:1.08;letter-spacing:-.05em}.page-hero p:last-child{max-width:760px;color:#dce4ed;font-size:18px}
  .content-section{padding:72px max(8vw,24px)}.content-section h2{font-size:clamp(28px,3.5vw,44px);line-height:1.15;letter-spacing:-.04em}.content-section p{max-width:800px;color:var(--muted)}.soft-section{background:var(--soft)}.card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.info-card{padding:24px;border:1px solid #e0e5eb;border-radius:10px;background:#fff}.info-card h3{margin:12px 0 8px}.info-card p{margin:0;font-size:14px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:11px 18px;border:1px solid #aab5c1;border-radius:6px;font-weight:750}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
  .site-footer{display:grid;grid-template-columns:minmax(0,2fr) minmax(180px,1fr);gap:30px;padding:36px max(5vw,24px);color:#dce4ed;background:#101e30;font-size:13px}.site-footer p{margin:4px 0}.site-footer>div{display:flex;flex-direction:column;gap:7px}.footer-contact{display:flex;flex-direction:column;gap:5px;margin-top:12px;padding-top:12px;border-top:1px solid rgba(220,228,237,.2)}.footer-contact span{color:#b8c5d3}.footer-links{align-self:center}
  /* Scroll reveals and staggered cards remain opt-in until the script is ready. */
  .motion-ready [data-motion="reveal"],.motion-ready [data-motion="stagger"]{opacity:0;transform:translate3d(0,20px,0);transition:opacity var(--motion-duration-base) var(--motion-ease),transform var(--motion-duration-base) var(--motion-ease)}
  .motion-ready [data-motion="reveal"].motion-visible,.motion-ready [data-motion="stagger"].motion-visible{opacity:1;transform:translate3d(0,0,0)}
  .motion-ready [data-motion="stagger"]>.motion-stagger-item{opacity:0;transform:translate3d(0,16px,0);transition:opacity var(--motion-duration-base) var(--motion-ease),transform var(--motion-duration-base) var(--motion-ease);transition-delay:calc(var(--motion-stagger-index,0)*65ms)}
  .motion-ready [data-motion="stagger"].motion-visible>.motion-stagger-item{opacity:1;transform:translate3d(0,0,0)}

  /* Homepage feature animations: deliberately visible, but still restrained. */
  .motion-ready .profile-feature>.motion-profile-item{transform:translate3d(-64px,0,0) scale(.94);filter:blur(5px);transition:opacity 850ms cubic-bezier(.2,.75,.2,1),transform 850ms cubic-bezier(.2,.75,.2,1),filter 850ms ease;transition-delay:calc(var(--motion-stagger-index,0)*180ms)}
  .motion-ready .profile-feature>.motion-profile-item:last-child{transform:translate3d(64px,30px,0) scale(.88) rotate(2deg)}
  .motion-ready .profile-feature.motion-visible>.motion-profile-item{opacity:1;transform:translate3d(0,0,0) scale(1) rotate(0);filter:blur(0)}
  .motion-ready .story-steps>.motion-story-item{transform:translate3d(0,54px,0) scale(.92) rotateX(7deg);transform-origin:center bottom;transition:opacity 760ms cubic-bezier(.2,.75,.2,1),transform 760ms cubic-bezier(.2,.75,.2,1);transition-delay:calc(var(--motion-stagger-index,0)*220ms)}
  .motion-ready .story-steps.motion-visible>.motion-story-item{opacity:1;transform:translate3d(0,0,0) scale(1) rotateX(0)}
  .motion-ready .showcase-track>.motion-showcase-item{transform:translate3d(0,58px,0) scale(.9);transition:opacity 780ms cubic-bezier(.2,.75,.2,1),transform 780ms cubic-bezier(.2,.75,.2,1);transition-delay:calc(var(--motion-stagger-index,0)*150ms)}
  .motion-ready .showcase-track.motion-visible>.motion-showcase-item{opacity:1;transform:translate3d(0,0,0) scale(1)}
  .motion-ready .showcase-card img{transform:scale(1.12);transition:transform 1100ms cubic-bezier(.2,.75,.2,1)}
  .motion-ready .showcase-track.motion-visible .showcase-card img{transform:scale(1)}
  @media(prefers-reduced-motion:reduce){.motion-ready .profile-feature>.motion-profile-item,.motion-ready .story-steps>.motion-story-item,.motion-ready .showcase-track>.motion-showcase-item{filter:none;transform:none!important;transition:none!important}.motion-ready .showcase-card img{transform:none!important;transition:none!important}}

  .motion-hover-lift{transition:transform var(--motion-duration-fast) var(--motion-ease),box-shadow var(--motion-duration-fast) var(--motion-ease)}
  @media(hover:hover) and (pointer:fine){.motion-hover-lift:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(23,43,69,.12)}.button:hover,.nav-cta:hover{transform:translateY(-2px);box-shadow:0 8px 18px rgba(23,43,69,.14)}}
  .button,.nav-cta{transition:transform var(--motion-duration-fast) var(--motion-ease),box-shadow var(--motion-duration-fast) var(--motion-ease)}
  .button:active,.nav-cta:active{transform:translateY(0) scale(.98)}
  .faq-item{interpolate-size:allow-keywords}
  .faq-item::details-content{block-size:0;overflow:clip;transition:block-size 280ms var(--motion-ease),content-visibility 280ms allow-discrete}
  .faq-item[open]::details-content{block-size:auto}
  @keyframes gentle-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
  @media(prefers-reduced-motion:no-preference){.profile-feature-photo,.about-hero-visual{animation:gentle-float 7s ease-in-out infinite}}
  @media(prefers-reduced-motion:no-preference){@view-transition{navigation:auto}::view-transition-old(root){animation:page-fade-out 120ms ease both}::view-transition-new(root){animation:page-fade-in 220ms ease both}}
  @keyframes page-fade-out{to{opacity:0}}@keyframes page-fade-in{from{opacity:0}to{opacity:1}}
  @media(max-width:760px){
    .site-header{min-height:72px;align-items:center;flex-direction:row;padding:10px 18px}
    .brand-logo{width:min(205px,62vw);max-height:52px}
    .mobile-menu-toggle{display:block;flex:0 0 44px;margin-left:auto}
    #primary-navigation{position:absolute;top:calc(100% + 1px);right:14px;left:14px;z-index:150;display:flex;flex-direction:column;align-items:stretch;gap:0;width:auto;padding:8px;border:1px solid #e0e5eb;border-radius:12px;background:#fff;box-shadow:0 18px 38px rgba(23,43,69,.18);opacity:0;visibility:hidden;transform:translateY(-8px);pointer-events:none;transition:opacity 180ms ease,transform 180ms ease,visibility 180ms ease}
    #primary-navigation.is-open{opacity:1;visibility:visible;transform:translateY(0);pointer-events:auto}
    #primary-navigation a{display:block;padding:12px 14px;border-radius:7px;font-size:15px}
    #primary-navigation a:hover{background:#f4f6f8}
    #primary-navigation .nav-cta{margin-top:5px;text-align:center;background:var(--yellow)}
    .page-hero{padding-top:58px;padding-bottom:58px}.content-section{padding-top:54px;padding-bottom:54px}.card-grid{grid-template-columns:1fr}.site-footer{grid-template-columns:1fr}
  }
  @media(prefers-reduced-motion:reduce){.mobile-menu-toggle span,#primary-navigation{transition:none!important}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}.scroll-progress span{will-change:auto}.motion-ready [data-motion],.motion-ready [data-motion]>.motion-stagger-item{opacity:1!important;transform:none!important;clip-path:none!important}}
  /* Phase 5 interaction layer: restrained, touch-safe and motion-preference aware. */
  .button,.nav-cta{position:relative;overflow:hidden;isolation:isolate}
  .magnetic-button{transform:translate3d(var(--mag-x,0px),var(--mag-y,0px),0);will-change:transform}
  .magnetic-button:hover{transform:translate3d(var(--mag-x,0px),calc(var(--mag-y,0px) - 2px),0)}
  .interaction-ripple{position:absolute;z-index:0;display:block;border-radius:50%;pointer-events:none;background:rgba(255,255,255,.48);transform:scale(0);animation:interactionRipple 620ms ease-out forwards}
  .button-primary .interaction-ripple,.nav-cta .interaction-ripple{background:rgba(23,43,69,.18)}
  @keyframes interactionRipple{to{transform:scale(1);opacity:0}}
  .cursor-follower{position:fixed;top:0;left:0;z-index:3000;width:12px;height:12px;border:1.5px solid rgba(245,197,66,.9);border-radius:50%;pointer-events:none;opacity:0;transition:opacity 160ms ease,width 180ms ease,height 180ms ease,background 180ms ease;will-change:transform}
  .cursor-follower.is-visible{opacity:1}
  .cursor-follower.is-hovering{width:26px;height:26px;background:rgba(245,197,66,.14)}
  @media(hover:none),(pointer:coarse){.cursor-follower{display:none}}
  @media(prefers-reduced-motion:reduce){.magnetic-button{transform:none!important;will-change:auto}.interaction-ripple,.cursor-follower{display:none!important}}
</style>

---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="About Paver Blocks | Mithal Shahan, Civil Contractor" description="Learn about Paver Blocks, the public brand of Mithal Shahan, a civil contractor with 40+ years of personal experience since 1986." canonical="https://paverblocks.com.pk/about/">
  <section class="page-hero about-hero">
    <div class="about-hero-grid">
      <div class="about-hero-copy">
        <p class="eyebrow">About Paver Blocks</p>
        <h1>Experience grounded in practical work.</h1>
        <p>Paver Blocks is the public brand of Mithal Shahan, Civil Contractor, based in Hyderabad, Sindh and serving projects across Pakistan.</p>
      </div>
      <div class="about-hero-visual">
        <svg class="paving-illustration" viewBox="0 0 640 440" role="img" aria-labelledby="paving-title paving-desc" xmlns="http://www.w3.org/2000/svg">
          <title id="paving-title">Paver road construction illustration</title>
          <desc id="paving-desc">An isometric paved roadway with interlocking blocks, a compact yellow road roller and construction details.</desc>
          <defs>
            <linearGradient id="roadTop" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#F7F9FC"/><stop offset="1" stop-color="#BFCAD6"/></linearGradient>
            <linearGradient id="rollerYellow" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFE17A"/><stop offset="1" stop-color="#E3A900"/></linearGradient>
            <linearGradient id="roadSide" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8293A6"/><stop offset="1" stop-color="#53677E"/></linearGradient>
            <filter id="softShadow" x="-30%" y="-30%" width="160%" height="170%"><feGaussianBlur stdDeviation="10"/></filter>
          </defs>
          <circle cx="466" cy="104" r="78" fill="#F5C542" opacity=".12"/>
          <circle cx="142" cy="90" r="48" fill="#fff" opacity=".06"/>
          <path d="M66 326 335 174 588 318 315 423Z" fill="#071426" opacity=".32" filter="url(#softShadow)"/>
          <path d="M48 285 324 126 592 278 316 438Z" fill="url(#roadSide)"/>
          <path d="M48 265 324 106 592 258 316 418Z" fill="url(#roadTop)" stroke="#fff" stroke-opacity=".65" stroke-width="3"/>
          <path d="m82 264 242-139 228 130-241 139Z" fill="#66788B"/>
          <g stroke="#DDE4EB" stroke-width="2" opacity=".95">
            <path d="m102 275 241-139M143 299l241-139M184 322l241-139M225 345l241-139M266 368l241-139"/>
            <path d="m123 240 228 130M164 216l228 130M205 192l228 130M246 169l228 130M287 145l228 130"/>
          </g>
          <g fill="#F5C542" stroke="#D49A00" stroke-width="2">
            <path d="m120 270 27-16 28 16-27 16Z"/><path d="m174 301 27-16 28 16-27 16Z"/><path d="m228 332 27-16 28 16-27 16Z"/>
          </g>
          <path d="m68 252 256-148 30 17L98 270Z" fill="#fff" opacity=".22"/>
          <path d="m354 117 17-10 206 117-17 10Z" fill="#F5C542"/>
          <g transform="translate(240 52)">
            <ellipse cx="116" cy="155" rx="112" ry="24" fill="#071426" opacity=".28"/>
            <path d="M37 112h156v36H37z" fill="#D99E00"/>
            <rect x="34" y="88" width="165" height="47" rx="15" fill="url(#rollerYellow)" stroke="#C58F00" stroke-width="3"/>
            <path d="M74 88V53q0-10 11-10h48q13 0 13 12v33Z" fill="#F5C542" stroke="#C58F00" stroke-width="3"/>
            <path d="M88 80V56q0-5 6-5h34q6 0 6 6v23Z" fill="#294969"/>
            <path d="M94 57h34v22H94z" fill="#9CC0D8" opacity=".8"/>
            <path d="M145 91h31l14 18h-45Z" fill="#F8D66A"/>
            <rect x="21" y="119" width="190" height="20" rx="10" fill="#26394F"/>
            <ellipse cx="53" cy="139" rx="30" ry="31" fill="#26394F"/><ellipse cx="53" cy="139" rx="18" ry="19" fill="#AEBBC8"/>
            <ellipse cx="183" cy="139" rx="28" ry="29" fill="#26394F"/><ellipse cx="183" cy="139" rx="16" ry="17" fill="#AEBBC8"/>
            <path d="M16 110q-9 0-9 10v10q0 9 9 9h9v-29Z" fill="#D4DCE4"/>
            <path d="M200 98h17v31h-17z" fill="#172B45"/>
            <path d="M76 44h55" stroke="#fff" stroke-width="4" stroke-linecap="round" opacity=".7"/>
          </g>
          <g fill="#F5C542">
            <circle cx="542" cy="88" r="5"/><circle cx="562" cy="108" r="3"/><circle cx="96" cy="145" r="4"/>
          </g>
          <g stroke="#F5C542" stroke-width="4" stroke-linecap="round" opacity=".9"><path d="m524 55 10-10M552 62l6-13M82 112l-8-8"/></g>
          <path d="M80 367 119 389M523 350l42 24" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".3"/>
        </svg>
        <span class="visual-caption"><span class="visual-caption-dot"></span> Paving &amp; civil construction</span>
      </div>
    </div>
  </section>
  <section class="content-section profile-feature-section">
    <div class="profile-feature">
      <div class="profile-feature-copy">
        <p class="eyebrow">Our background</p>
        <h2>40+ years of personal experience</h2>
        <p>Mithal Shahan began his professional journey on 6 November 1986. That hands-on experience informs our approach to paving and related civil construction work.</p>
        <p>Our primary focus is paver block installation and paving-related civil works. When a project requires paver products, we can help clients identify and source suitable options from independent manufacturers and suppliers. Paver Blocks does not claim to manufacture pavers.</p>
      </div>
      <figure class="profile-feature-photo">
        <img src="https://raw.githubusercontent.com/paverblockswebsite/Paver-Blocks/main/Mithal%20Shahan.PNG" alt="Portrait of Mithal Shahan, Civil Contractor" width="1023" height="1011" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
  <section class="content-section soft-section"><p class="eyebrow">How we work</p><div class="card-grid"><article class="info-card"><h3>Understand the site</h3><p>We begin by understanding the location, intended use, site conditions and approximate project area.</p></article><article class="info-card"><h3>Clarify the scope</h3><p>We discuss the work required so that expectations and project requirements are clear.</p></article><article class="info-card"><h3>Discuss next steps</h3><p>We communicate directly about the practical next steps for the proposed work.</p></article></div></section>
  <section class="content-section"><h2>Discuss your project with us</h2><p>Tell us what you are planning and where the work is located.</p><div class="actions"><a class="button button-primary" href="/get-a-quote/">Request a Quote</a><a class="button" href="/contact/">Contact Us</a></div></section>
</SiteLayout>
<style>
  .about-hero{padding-top:clamp(54px,7vw,88px);padding-bottom:clamp(54px,7vw,88px)}
  .about-hero-grid{width:100%;max-width:1440px;margin-inline:auto;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);align-items:center;gap:clamp(28px,5vw,72px)}
  .about-hero-copy{min-width:0}
  .about-hero-copy h1{max-width:680px;font-size:clamp(38px,5vw,64px)}
  .about-hero-copy>p:last-child{max-width:650px;margin-bottom:0}
  .about-hero-visual{position:relative;width:100%;max-width:620px;justify-self:end;padding:10px 0}
  .paving-illustration{display:block;width:100%;height:auto;overflow:visible}
  .visual-caption{display:flex;align-items:center;gap:9px;width:max-content;max-width:100%;margin:-2px auto 0;padding:9px 15px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:rgba(255,255,255,.08);color:#edf3f8;font-size:12px;font-weight:700;letter-spacing:.02em}
  .visual-caption-dot{width:8px;height:8px;flex:0 0 8px;border-radius:50%;background:#F5C542;box-shadow:0 0 0 4px rgba(245,197,66,.16)}
  .profile-feature-section{max-width:1280px;margin-inline:auto}
  .profile-feature{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);align-items:center;gap:clamp(28px,5vw,64px)}
  .profile-feature-copy{min-width:0}
  .profile-feature-copy>p:not(.eyebrow){max-width:760px}
  .profile-feature-photo{width:100%;max-width:460px;justify-self:end;margin:0 0 0 18px;overflow:hidden;border:1px solid #e0e5eb;border-radius:14px;background:#f4f6f8;box-shadow:0 18px 42px rgba(23,43,69,.12)}
  .profile-feature-photo img{display:block;width:100%;height:auto;aspect-ratio:1023/1011;object-fit:contain;object-position:center}
  @media(max-width:900px){.about-hero-grid{grid-template-columns:minmax(0,1fr) minmax(280px,.9fr);gap:24px}.about-hero-copy h1{font-size:clamp(36px,5vw,54px)}}
  @media(max-width:760px){.about-hero-grid{grid-template-columns:1fr;gap:20px}.about-hero-copy h1{max-width:620px}.about-hero-visual{max-width:560px;justify-self:center;padding:0}.visual-caption{margin-top:-4px}.profile-feature{grid-template-columns:1fr}.profile-feature-photo{max-width:400px;justify-self:center;margin:12px auto 0}}
  @media(max-width:380px){.about-hero-copy h1{font-size:36px}.visual-caption{font-size:11px;padding:8px 12px}}
</style>

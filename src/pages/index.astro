}}@keyframes homeContentEnter{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}.home-marquee{overflow:hidden;padding:16px 0;color:#172B45;background:#F5C542}.home-marquee-track{display:flex;align-items:center;gap:28px;width:max-content;white-space:nowrap;animation:homeMarquee 34s linear infinite}.home-marquee-track span{font-size:13px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.home-marquee-track i{font-style:normal;font-size:17px}@keyframes homeMarquee{to{transform:translateX(-50%)}}.content-section{padding:76px max(8vw,24px)}.content-section h2{max-width:760px;margin-bottom:18px;font-size:clamp(30px,4vw,46px);line-height:1.12;letter-spacing:-.04em}.content-section>p:not(.eyebrow){max-width:760px;color:#667386;font-size:17px}.intro{max-width:1280px}.profile-feature{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.65fr);align-items:center;gap:clamp(28px,5vw,64px)}.profile-feature-copy{min-width:0}.profile-feature-photo{width:100%;max-width:460px;justify-self:end;margin:0 0 0 18px;overflow:hidden;border:1px solid #e0e5eb;border-radius:14px;background:#f4f6f8;box-shadow:0 18px 42px rgba(23,43,69,.12)}.profile-feature-photo img{display:block;width:100%;height:auto;aspect-ratio:1023/1011;object-fit:contain;object-position:center}.profile-feature-copy>p:not(.eyebrow){max-width:760px}.text-link{display:inline-block;margin-top:12px;color:#8a6500;font-weight:800}.soft-section{background:#f4f6f8}.card-grid{margin:30px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.info-card{overflow:hidden;padding:0 0 24px;border:1px solid #e0e5eb;border-radius:10px;background:#fff}.service-image{width:100%;aspect-ratio:16/10;overflow:hidden;background:#e8edf2}.service-image img{display:block;width:100%;height:100%;object-fit:cover}.info-card .service-index,.info-card h3,.info-card>p,.info-card>.text-link{margin-left:24px;margin-right:24px}.service-index{color:#9b7410;font-size:10px;font-weight:850;letter-spacing:.13em}.info-card h3{margin:14px 0 8px;font-size:19px}.info-card p{color:#667386;font-size:14px}.paver-designs-home{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.7fr);gap:38px;align-items:center}.designs-intro h2{max-width:520px}.paver-design-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.paver-design-card{min-width:0;overflow:hidden;display:flex;flex-direction:column;border:1px solid #e0e5eb;border-radius:10px;background:#fff;transition:transform .2s ease,box-shadow .2s ease}.paver-design-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(23,43,69,.12)}.paver-design-card img{display:block;width:100%;height:clamp(130px,14vw,190px);padding:10px;object-fit:contain;background:#f4f6f8}.paver-design-card span{padding:12px 12px 2px;font-weight:850}.paver-design-card small{padding:0 12px 13px;color:#8a6500;font-weight:800}.dark-band{color:#fff;background:#172B45}.dark-band h2{color:#fff}.dark-band>p:not(.eyebrow){color:#dce4ed}.portfolio{background:linear-gradient(135deg,#f4f6f8 0%,#e9eef3 100%);border-top:1px solid #e1e6ed;border-bottom:1px solid #e1e6ed}.portfolio h2{color:#172B45}.portfolio>p:not(.eyebrow){color:#667386}.portfolio .button{margin-top:8px;color:#172B45;border-color:#172B45;background:transparent}.portfolio .button:hover{color:#fff;background:#172B45}.contact{position:relative;overflow:hidden;text-align:center;color:#fff;background:radial-gradient(ellipse at 50% 0%,#294969 0,transparent 58%),#172B45}.contact .eyebrow{color:#F5C542}.contact h2{color:#fff}.contact>p:not(.eyebrow){color:#dce4ed}.contact h2,.contact>p{margin-left:auto;margin-right:auto}.contact .actions{justify-content:center}.contact .button:not(.button-primary){color:#fff;border-color:#8a9aab;background:transparent}.contact .email-link{color:#F5C542}.email-link{display:inline-block;margin-top:10px;font-weight:800}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:11px 18px;border:1px solid #aab5c1;border-radius:6px;font-weight:750}.button-primary{border-color:transparent;color:#172B45;background:#F5C542}
@media(max-width:900px){.hero-visual{transform:none!important;will-change:auto}.profile-feature{grid-template-columns:1fr}.profile-feature-photo{max-width:400px;justify-self:center;margin:12px auto 0}.hero{grid-template-columns:1fr;min-height:auto;padding-top:64px;padding-bottom:54px}.hero-visual{justify-self:center;max-width:520px;min-height:clamp(240px,58vw,340px);margin-top:20px}.hero-scene img{max-height:340px}.paver-designs-home{grid-template-columns:1fr}.paver-design-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.hero{padding-top:56px;padding-bottom:46px}.hero-visual{min-height:clamp(220px,64vw,300px);margin-top:10px}.hero-scene img{max-height:300px}.content-section{padding-top:56px;padding-bottom:56px}.card-grid{grid-template-columns:1fr}.paver-design-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.paver-design-card img{height:clamp(130px,38vw,190px)}}@media(prefers-reduced-motion:reduce){.home-marquee-track{animation:none;transform:none}.hero-content{animation:none}.hero-visual{transform:none!important;will-change:auto}.hero-gif{animation:none;opacity:0}.hero-scene{animation:none;opacity:0}.hero-scene:nth-child(2){opacity:1}.hero-scene img{animation:none}}

.scroll-story{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.2fr);gap:clamp(32px,7vw,100px);align-items:start;background:#f4f6f8}
.story-sticky{position:sticky;top:110px;align-self:start}
.story-sticky h2{max-width:520px}
.story-steps{display:grid;gap:18px}
.story-step{min-height:190px;padding:28px;border:1px solid #dfe5eb;border-radius:12px;background:#fff;box-shadow:0 12px 30px rgba(23,43,69,.05)}
.story-step>span,.showcase-card>span{color:#9b7410;font-size:11px;font-weight:850;letter-spacing:.13em}
.story-step h3{margin:16px 0 8px;font-size:24px}
.story-step p{max-width:520px;color:#667386}
.horizontal-showcase{overflow:hidden}
.showcase-hint{font-size:13px!important}
.showcase-track{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(250px,32%);gap:16px;overflow-x:auto;padding:8px 4px 22px;scroll-snap-type:x mandatory;overscroll-behavior-inline:contain;scrollbar-color:#c6a23c #edf0f3}

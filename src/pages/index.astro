---
import SiteLayout from "../layouts/SiteLayout.astro";
const services = [
  ["Paver Block Installation","Professional paver installation for suitable outdoor surfaces.","/services/paver-block-installation/"],
  ["Road Construction & Paving","Road paving and related civil construction work.","/services/road-construction/"],
  ["Footpath Construction","Footpath and pedestrian-surface construction.","/services/footpath-construction/"],
  ["Parking Area Construction","Paving and construction for parking areas.","/services/parking-area-construction/"],
  ["Industrial Flooring","Industrial surface and flooring-related civil work.","/services/industrial-flooring/"],
  ["Government & Private Contracts","Paving and civil work contract enquiries.","/services/contracts/"]
];
---
<SiteLayout title="Paver Blocks | Paving & Civil Construction in Pakistan" description="Paver Blocks provides paver block installation, road paving, footpath, parking area and related civil construction services across Pakistan. Based in Hyderabad, Sindh." canonical="https://paverblocks.com.pk/">
  <section class="hero">
    <div class="hero-content">
      <p class="eyebrow">Mithal Shahan · Civil Contractor</p>
      <h1>Building Strong Foundations.<br /><span>Creating Lasting Roads.</span></h1>
      <p class="hero-copy">Professional paver block installation, road paving and civil construction services, serving projects across Pakistan from Hyderabad, Sindh.</p>
      <div class="actions"><a class="button button-primary" href="/get-a-quote/">Discuss Your Project</a><a class="button button-light" href="/services/">Explore Services</a></div>
      <p class="experience"><strong>40+ years</strong> of personal experience · Working since 1986</p>
    </div>
    <div class="hero-art" aria-hidden="true"><div class="paver-grid"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div><div class="road-line"></div></div>
  </section>
  <section class="content-section intro">
    <p class="eyebrow">About Paver Blocks</p><h2>Practical paving experience. Work built to last.</h2>
    <p>Paver Blocks is the public brand of Mithal Shahan, Civil Contractor. Our primary focus is professional paver installation and paving-related civil works. We can also help clients source suitable paver blocks from third-party manufacturers and suppliers.</p>
    <a class="text-link" href="/about/">Learn more about us →</a>
  </section>
  <section class="content-section soft-section">
    <p class="eyebrow">What We Do</p><h2>Construction and paving services</h2>
    <div class="card-grid">{services.map(([name,desc,url],i)=><article class="info-card"><span class="service-index">0{i+1} / SERVICE</span><h3>{name}</h3><p>{desc}</p><a class="text-link" href={url}>View service →</a></article>)}</div>
    <a class="button button-primary" href="/services/">View all services</a>
  </section>
  <section class="content-section designs">
    <div><p class="eyebrow">Paver Options</p><h2>Explore paver designs.</h2><p>We help clients identify suitable designs and connect with third-party suppliers when product sourcing is required.</p><a class="button" href="/paver-designs/">Explore designs</a></div>
    <div class="design-pattern" aria-hidden="true"><span>I-Shape</span><span>Zigzag</span><span>Rectangular</span><span>Uni-Paver</span></div>
  </section>
  <section class="content-section dark-band"><p class="eyebrow">Experience Since 1986</p><h2>Personal experience you can build on.</h2><p>Every project has its own requirements. Share your location, intended use and approximate area so we can understand the work involved.</p><a class="button button-primary" href="/get-a-quote/">Start a conversation</a></section>
  <section class="content-section portfolio"><p class="eyebrow">Our Work</p><h2>Project portfolio</h2><p>Explore verified project details and real photographs as they are added.</p><a class="button" href="/projects/">View project portfolio</a></section>
  <section class="content-section contact"><p class="eyebrow">Start a Conversation</p><h2>Tell us about your project.</h2><p>Based in Hyderabad, Sindh · Serving clients across Pakistan</p><div class="actions"><a class="button button-primary" href="https://wa.me/923162753210">WhatsApp: +92 316 2753210</a><a class="button" href="tel:+923162753210">Call Us</a></div><a class="email-link" href="mailto:hellopaverblocks@gmail.com">hellopaverblocks@gmail.com</a></section>
</SiteLayout>
<style>
.hero{position:relative;overflow:hidden;display:grid;grid-template-columns:1.35fr .65fr;align-items:center;min-height:570px;padding:88px max(8vw,24px);color:white;background:radial-gradient(ellipse at 78% 20%,#294969 0,transparent 42%),#172B45}.hero-content{position:relative;z-index:1}.hero h1{max-width:850px;margin:0 0 22px;font-size:clamp(42px,6vw,76px);line-height:1.06;letter-spacing:-.055em}.hero h1 span{color:#F5C542}.hero-copy{max-width:660px;color:#dce4ed;font-size:18px}.hero .eyebrow,.dark-band .eyebrow{color:#F5C542}.experience{margin:24px 0 0;color:#dce4ed;font-size:14px}.experience strong{color:#F5C542}.button-light{color:white;border-color:#8a9aab}.content-section{padding:76px max(8vw,24px)}.content-section h2{max-width:760px;margin-bottom:18px;font-size:clamp(30px,4vw,46px);line-height:1.12;letter-spacing:-.04em}.content-section>p:not(.eyebrow){max-width:760px;color:#667386;font-size:17px}.intro{max-width:1100px}.text-link{display:inline-block;margin-top:12px;color:#8a6500;font-weight:800}.soft-section{background:#f4f6f8}.card-grid{margin:30px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.info-card{padding:24px;border:1px solid #e0e5eb;border-radius:10px;background:#fff}.service-index{color:#9b7410;font-size:10px;font-weight:850;letter-spacing:.13em}.info-card h3{margin:14px 0 8px;font-size:19px}.info-card p{color:#667386;font-size:14px}.designs{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}.design-pattern{min-height:260px;padding:25px;display:grid;grid-template-columns:1fr 1fr;gap:12px;align-content:center;background:linear-gradient(135deg,#172B45,#294969);border-radius:12px;transform:skewY(-2deg)}.design-pattern span{padding:22px 10px;color:#172B45;background:#F5C542;text-align:center;font-weight:850;border-radius:5px;transform:skewY(2deg)}.dark-band{color:#fff;background:#172B45}.dark-band h2{color:#fff}.dark-band>p:not(.eyebrow){color:#dce4ed}.portfolio{background:#fff}.contact{text-align:center}.contact h2,.contact>p{margin-left:auto;margin-right:auto}.contact .actions{justify-content:center}.email-link{display:inline-block;margin-top:10px;font-weight:800}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:11px 18px;border:1px solid #aab5c1;border-radius:6px;font-weight:750}.button-primary{border-color:transparent;color:#172B45;background:#F5C542}
@media(max-width:760px){.hero{grid-template-columns:1fr;min-height:auto;padding-top:66px;padding-bottom:66px}.hero-art{display:none}.content-section{padding-top:56px;padding-bottom:56px}.card-grid,.designs{grid-template-columns:1fr}}
</style>
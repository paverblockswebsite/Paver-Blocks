---
import SiteLayout from "../layouts/SiteLayout.astro";
import { fetchPublicList } from "../lib/public-cms.js";
const publicApiBase = import.meta.env.VITE_PUBLIC_API_BASE_URL || "";
const testimonials = await fetchPublicList("/api/public/testimonials");
const services = [
  { name: "Paver Block Installation", description: "Professional paver installation for suitable outdoor surfaces.", url: "/services/paver-block-installation/", image: "/images/services/paver-block-installation.jpg", alt: "Paver block installation on an outdoor paved surface" },
  { name: "Road Construction & Paving", description: "Road paving and related civil construction work.", url: "/services/road-construction/", image: "/images/services/road-construction.jpg", alt: "Road construction and paving work" },
  { name: "Footpath Construction", description: "Footpath and pedestrian-surface construction.", url: "/services/footpath-construction/", image: "/images/services/footpath-construction.jpg", alt: "Paved pedestrian footpath in a landscaped area" },
  { name: "Parking Area Construction", description: "Paving and construction for parking areas.", url: "/services/parking-area-construction/", image: "/images/services/parking-area-construction.jpg", alt: "Paved driveway and parking area outside a modern building" },
  { name: "Industrial Flooring", description: "Industrial surface and flooring-related civil work.", url: "/services/industrial-flooring/", image: "/images/services/industrial-flooring.jpg", alt: "Industrial paving and flooring facility" },
  { name: "Government & Private Contracts", description: "Paving and civil work contract enquiries.", url: "/services/contracts/", image: "/images/services/paver-block-materials.jpg", alt: "Paver block materials for paving and civil construction projects" }
];
---
<SiteLayout title="Paver Blocks | Paving & Civil Construction in Pakistan" description="Paver Blocks provides paver block installation, road paving, footpath, parking area and related civil construction services across Pakistan. Based in Hyderabad, Sindh." canonical="https://paverblocks.com.pk/">
  <section class="hero" data-public-api-base={publicApiBase}>
    <div class="hero-content">
      <p class="eyebrow">Mithal Shahan · Civil Contractor</p>
      <h1 id="homepage-hero-title">Building Strong Foundations.<br /><span data-scramble>Creating Lasting Roads.</span></h1>
      <p class="hero-copy" id="homepage-hero-subtitle">Professional paver block installation, road paving and civil construction services, serving projects across Pakistan from Hyderabad, Sindh.</p>
      <div class="actions"><a class="button button-primary" id="homepage-hero-cta" href="/get-a-quote/">Discuss Your Project</a><a class="button button-light" href="/services/">Explore Services</a></div>
      <p class="experience" id="homepage-experience"><strong data-count-to="40">40+ years</strong> of personal experience · Working since 1986</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-gif"><img src="/images/homepage-hero-animation.gif" alt="" width="380" height="250" fetchpriority="high" decoding="async" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/paver-blocks.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/curved-road.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/modern-home.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/park-walkway.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/road-roller.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <svg class="hero-line-art" viewBox="0 0 520 420" aria-hidden="true" focusable="false"><path d="M18 320 C100 250 135 360 220 270 S360 175 500 90" /><path d="M28 365 C120 300 155 395 245 310 S390 215 510 135" /></svg>
    </div>
  </section>
  <div class="home-marquee" aria-label="Paver block installation, road paving, footpaths, parking areas and industrial flooring"><div class="home-marquee-track" aria-hidden="true"><span>Paver Block Installation</span><i>✦</i><span>Road Construction</span><i>✦</i><span>Footpath Construction</span><i>✦</i><span>Parking Areas</span><i>✦</i><span>Industrial Flooring</span><i>✦</i><span>Paver Block Installation</span><i>✦</i><span>Road Construction</span><i>✦</i><span>Footpath Construction</span><i>✦</i><span>Parking Areas</span><i>✦</i><span>Industrial Flooring</span><i>✦</i></div></div>
  <section class="content-section intro">
    <div class="profile-feature">
      <div class="profile-feature-copy">
        <p class="eyebrow">About Paver Blocks</p><h2 id="homepage-about-heading">Practical paving experience. Work built to last.</h2>
        <p id="homepage-about-text">Paver Blocks is the public brand of Mithal Shahan, Civil Contractor. Our primary focus is professional paver installation and paving-related civil works. We can also help clients source suitable paver blocks from third-party manufacturers and suppliers.</p>
        <a class="text-link" href="/about/">Learn more about us →</a>
      </div>
      <figure class="profile-feature-photo">
        <img src="https://raw.githubusercontent.com/paverblockswebsite/Paver-Blocks/main/Mithal%20Shahan.PNG" alt="Portrait of Mithal Shahan, Civil Contractor" width="1023" height="1011" loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>
  <section class="content-section soft-section">
    <p class="eyebrow">What We Do</p><h2>Construction and paving services</h2>
    <div class="card-grid">{services.map((service,i)=><article class="info-card"><div class="service-image"><img src={service.image} alt={service.alt} loading="lazy" decoding="async" /></div><span class="service-index">0{i+1} / SERVICE</span><h3>{service.name}</h3><p>{service.description}</p><a class="text-link" href={service.url}>View service →</a></article>)}</div>
    <a class="button button-primary" href="/services/">View all services</a>
  </section>
  <section class="content-section paver-designs-home">
    <div class="designs-intro"><p class="eyebrow">Paver Options</p><h2>Explore paver designs.</h2><p>Compare popular paver shapes and ask us about suitability, available sizes, thicknesses and colours. Availability depends on independent suppliers.</p><a class="button" href="/paver-designs/">Explore all designs</a></div>
    <div class="paver-design-grid">
      <a class="paver-design-card" href="/paver-designs/i-shape/"><img src="/images/paver-designs/i-shape-paver.webp" alt="Grey I-shape interlocking concrete paver block" width="360" height="360" loading="lazy" /><span>I-Shape</span><small>View design →</small></a>
      <a class="paver-design-card" href="/paver-designs/zigzag/"><img src="/images/paver-designs/zigzag-paver.webp" alt="Interlocking zigzag concrete paver block" width="360" height="360" loading="lazy" /><span>Zigzag</span><small>View design →</small></a>
      <a class="paver-design-card" href="/paver-designs/rectangular/"><img src="/images/paver-designs/rectangular-paver.jpg" alt="Rectangular concrete paving blocks in grey, red and charcoal" width="360" height="237" loading="lazy" /><span>Rectangular</span><small>View design →</small></a>
      <a class="paver-design-card" href="/paver-designs/uni-paver/"><img src="/images/paver-designs/uni-paver.jpeg" alt="Red Uni-Paver interlocking concrete block" width="360" height="360" loading="lazy" /><span>Uni-Paver</span><small>View design →</small></a>
    </div>
  </section>
  <section class="content-section scroll-story" aria-labelledby="scroll-story-title">
    <div class="story-sticky"><p class="eyebrow">How We Work</p><h2 id="scroll-story-title">A considered approach to every paving project.</h2><p>From understanding the site to planning the paving work, each stage starts with your requirements.</p><a class="text-link" href="/get-a-quote/">Discuss your project →</a></div>
    <div class="story-steps">
      <article class="story-step"><span>01 / Understand</span><h3>Understand the site</h3><p>Share the location, intended use and approximate area so the work can be understood clearly.</p></article>
      <article class="story-step"><span>02 / Plan</span><h3>Consider suitable options</h3><p>Discuss paving patterns, product availability and practical requirements with independent suppliers where needed.</p></article>
      <article class="story-step"><span>03 / Deliver</span><h3>Plan the installation</h3><p>Agree the scope of paving and related civil work before the project moves forward.</p></article>
    </div>
  </section>
  <section class="content-section horizontal-showcase" aria-labelledby="horizontal-showcase-title">
    <p class="eyebrow">Paving Applications</p><h2 id="horizontal-showcase-title">Explore the work we undertake.</h2><p class="showcase-hint">Scroll horizontally to explore each application.</p>
    <div class="showcase-track" tabindex="0" aria-label="Horizontally scrollable paving applications">
      <article class="showcase-card"><img src="/images/services/paver-block-installation.jpg" alt="Paver block installation" loading="lazy" /><span>01</span><h3>Paver installation</h3></article>
      <article class="showcase-card"><img src="/images/services/road-construction.jpg" alt="Road construction and paving" loading="lazy" /><span>02</span><h3>Road construction</h3></article>
      <article class="showcase-card"><img src="/images/services/footpath-construction.jpg" alt="Paved pedestrian footpath" loading="lazy" /><span>03</span><h3>Footpaths</h3></article>
      <article class="showcase-card"><img src="/images/services/parking-area-construction.jpg" alt="Paved parking area" loading="lazy" /><span>04</span><h3>Parking areas</h3></article>
      <article class="showcase-card"><img src="/images/services/industrial-flooring.jpg" alt="Industrial flooring work" loading="lazy" /><span>05</span><h3>Industrial flooring</h3></article>
    </div>
  </section>
  <section class="content-section dark-band"><p class="eyebrow">Experience Since 1986</p><h2>Personal experience you can build on.</h2><p>Every project has its own requirements. Share your location, intended use and approximate area so we can understand the work involved.</p><a class="button button-primary" href="/get-a-quote/">Start a conversation</a></section>
  <section class="content-section portfolio"><p class="eyebrow">Our Work</p><h2>Project portfolio</h2><p>Explore verified project details and real photographs as they are added.</p><a class="button" href="/projects/">View project portfolio</a></section>
  {testimonials.length > 0 && <section class="content-section testimonials" aria-labelledby="testimonials-title">
    <p class="eyebrow">Client Feedback</p><h2 id="testimonials-title">What clients say.</h2>
    <div class="card-grid">{testimonials.map((testimonial) => <article class="info-card testimonial-card">
      <blockquote><p>{testimonial.testimonial_text}</p></blockquote>
      <p class="testimonial-author"><strong>{testimonial.customer_display_name}</strong>{testimonial.customer_role_or_company && <span> · {testimonial.customer_role_or_company}</span>}</p>
    </article>)}</div>
  </section>}
  <section class="content-section contact"><p class="eyebrow">Start a Conversation</p><h2>Tell us about your project.</h2><p>Based in Hyderabad, Sindh · Serving clients across Pakistan</p><div class="actions"><a class="button button-primary" href="https://wa.me/923162753210">WhatsApp: +92 316 2753210</a><a class="button" href="tel:+923162753210">Call Us</a></div><a class="email-link" href="mailto:hellopaverblocks@gmail.com">hellopaverblocks@gmail.com</a></section>
</SiteLayout>

<script>
  // Homepage-only motion: gentle parallax and an honest 40+ experience count-up.
  const homeHero = document.querySelector(".hero");
  const homeVisual = document.querySelector(".hero-visual");
  const countTarget = document.querySelector("[data-count-to]");
  const reduceHomeMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!reduceHomeMotion && homeHero && homeVisual) {
    let parallaxFrame = 0;
    const updateHeroParallax = () => {
      parallaxFrame = 0;
      const rect = homeHero.getBoundingClientRect();
      if (rect.bottom > 0 && rect.top < window.innerHeight) {
        const offset = Math.max(-34, Math.min(34, -rect.top * 0.09));
        homeVisual.style.setProperty("--hero-parallax-y", String(offset) + "px");
      }
    };
    window.addEventListener("scroll", () => {
      if (!parallaxFrame) parallaxFrame = window.requestAnimationFrame(updateHeroParallax);
    }, { passive: true });
    updateHeroParallax();
  }
  if (countTarget && !reduceHomeMotion && "IntersectionObserver" in window) {
    const finalCount = Number(countTarget.dataset.countTo);
    const countObserver = new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      const started = performance.now();
      const tick = (now) => {
        const progress = Math.min(1, (now - started) / 1200);
        countTarget.textContent = String(Math.round(finalCount * (1 - Math.pow(1 - progress, 3)))) + "+ years";
        if (progress < 1) window.requestAnimationFrame(tick);
      };
      window.requestAnimationFrame(tick);
    }, { threshold: 0.65 });
    countObserver.observe(countTarget);
  }

  const hero = document.querySelector("[data-public-api-base]");
  const configuredApiBase = hero?.dataset.publicApiBase?.trim();

  if (configuredApiBase) {
    try {
      const apiOrigin = new URL(configuredApiBase);
      const isLocalDevelopment = ["localhost", "127.0.0.1"].includes(apiOrigin.hostname);
      if ((apiOrigin.protocol === "https:" || (isLocalDevelopment && apiOrigin.protocol === "http:")) &&
          apiOrigin.pathname === "/" && !apiOrigin.search && !apiOrigin.hash && !apiOrigin.username && !apiOrigin.password) {
        const endpoint = new URL("/api/public/site-settings", apiOrigin.origin);
        const response = await fetch(endpoint, {
          method: "GET",
          mode: "cors",
          credentials: "omit",
          headers: { Accept: "application/json" },
          signal: AbortSignal.timeout(5000)
        });
        if (response.ok) {
          const result = await response.json();
          const data = result && typeof result.data === "object" && result.data !== null ? result.data : {};
          const targets = {
            hero_title: ["homepage-hero-title", 120],
            hero_subtitle: ["homepage-hero-subtitle", 300],
            hero_cta_label: ["homepage-hero-cta", 60],
            about_heading: ["homepage-about-heading", 120],
            about_text: ["homepage-about-text", 2000],
            experience_statement: ["homepage-experience", 180]
          };
          for (const [key, [id, maxLength]] of Object.entries(targets)) {
            const value = data[key];
            const target = document.getElementById(id);
            if (target && typeof value === "string" && value.trim() && value.length <= maxLength) {
              target.textContent = value.trim();
            }
          }
        }
      }
    } catch {
      // Keep the approved static homepage copy if the public API is unavailable.
    }
  }
</script>

<style>

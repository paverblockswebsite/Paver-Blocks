.contact{isolation:isolate}
.contact::before,.contact::after{content:"";position:absolute;z-index:-1;width:clamp(160px,24vw,300px);aspect-ratio:1;border:1px solid rgba(245,197,66,.2);border-radius:62% 38% 45% 55%/48% 55% 45% 52%;background:radial-gradient(circle,rgba(245,197,66,.13),transparent 68%);animation:contactParticleDrift 18s ease-in-out infinite alternate}
.contact::before{top:-18%;left:7%}
.contact::after{right:6%;bottom:-35%;animation-delay:-8s;transform:rotate(70deg)}
@keyframes contactParticleDrift{to{transform:translate3d(18px,-22px,0) rotate(35deg);border-radius:38% 62% 55% 45%/55% 42% 58% 45%}}
@media(max-width:900px){.scroll-story{grid-template-columns:1fr}.story-sticky{position:relative;top:auto}.showcase-track{grid-auto-columns:minmax(250px,68%)}}
@media(max-width:600px){.showcase-track{grid-auto-columns:84%}.story-step{min-height:0;padding:22px}}
@media(prefers-reduced-motion:reduce){.contact::before,.contact::after{animation:none}}
</style>
<style>

---
import SiteLayout from "../layouts/SiteLayout.astro";
const publicApiBase = import.meta.env.VITE_PUBLIC_API_BASE_URL || "";
const services = [
  ["Paver Block Installation","Professional paver installation for suitable outdoor surfaces.","/services/paver-block-installation/"],
  ["Road Construction & Paving","Road paving and related civil construction work.","/services/road-construction/"],
  ["Footpath Construction","Footpath and pedestrian-surface construction.","/services/footpath-construction/"],
  ["Parking Area Construction","Paving and construction for parking areas.","/services/parking-area-construction/"],
  ["Industrial Flooring","Industrial surface and flooring-related civil work.","/services/industrial-flooring/"],
  ["Government & Private Contracts","Paving and civil work contract enquiries.","/services/contracts/"]
];
---
<SiteLayout title="Paver Blocks | Paving & Civil Construction in Pakistan" description="Paver Blocks provides paver block installation, road paving, footpath, parking area and related civil construction services across Pakistan. Based in Hyderabad, Sindh." canonical="https://paverblocks.com.pk/">
  <section class="hero" data-public-api-base={publicApiBase}>
    <div class="hero-content">
      <p class="eyebrow">Mithal Shahan · Civil Contractor</p>
      <h1 id="homepage-hero-title">Building Strong Foundations.<br /><span>Creating Lasting Roads.</span></h1>
      <p class="hero-copy" id="homepage-hero-subtitle">Professional paver block installation, road paving and civil construction services, serving projects across Pakistan from Hyderabad, Sindh.</p>
      <div class="actions"><a class="button button-primary" id="homepage-hero-cta" href="/get-a-quote/">Discuss Your Project</a><a class="button button-light" href="/services/">Explore Services</a></div>
      <p class="experience" id="homepage-experience"><strong>40+ years</strong> of personal experience · Working since 1986</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-scene"><img src="/images/homepage-scenes/paver-blocks.svg" alt="" width="640" height="520" fetchpriority="high" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/curved-road.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/modern-home.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/park-walkway.svg" alt="" width="640" height="520" loading="lazy" /></div>
      <div class="hero-scene"><img src="/images/homepage-scenes/road-roller.svg" alt="" width="640" height="520" loading="lazy" /></div>
    </div>
  </section>
  <section class="content-section intro">
    <p class="eyebrow">About Paver Blocks</p><h2 id="homepage-about-heading">Practical paving experience. Work built to last.</h2>
    <p id="homepage-about-text">Paver Blocks is the public brand of Mithal Shahan, Civil Contractor. Our primary focus is professional paver installation and paving-related civil works. We can also help clients source suitable paver blocks from third-party manufacturers and suppliers.</p>
    <a class="text-link" href="/about/">Learn more about us →</a>
  </section>
  <section class="content-section soft-section">
    <p class="eyebrow">What We Do</p><h2>Construction and paving services</h2>
    <div class="card-grid">{services.map(([name,desc,url],i)=><article class="info-card"><span class="service-index">0{i+1} / SERVICE</span><h3>{name}</h3><p>{desc}</p><a class="text-link" href={url}>View service →</a></article>)}</div>
    <a class="button button-primary" href="/services/">View all services</a>
  </section>
  <section class="content-section paver-designs-home">
    <div class="designs-intro"><p class="eyebrow">Paver Options</p><h2>Explore paver designs.</h2><p>Compare popular paver shapes and ask us about suitability, available sizes, thicknesses and colours. Availability depends on independent suppliers.</p><a class="button" href="/paver-designs/">Explore all designs</a></div>
    <div class="paver-design-grid">
      <a class="paver-design-card" href="/paver-designs/i-shape/"><img src="/images/paver-designs/i-shape-paver.webp" alt="Grey I-shape interlocking concrete paver block" width="360" height="360" loading="lazy" /><span>I-Shape</span><small>View design →</small></a>
      <a class="paver-design-card" href="/paver-designs/zigzag/"><img src="/images/paver-designs/zigzag-paver.webp" alt="Interlocking zigzag concrete paver block" width="360" height="360" loading="lazy" /><span>Zigzag</span><small>View design →</small></a>
      <a class="paver-design-card" href="/paver-designs/rectangular/"><img src="/images/paver-designs/rectangular-paver.webp" alt="Rectangular concrete paving blocks in grey, red and charcoal" width="360" height="237" loading="lazy" /><span>Rectangular</span><small>View design →</small></a>
      <a class="paver-design-card" href="/paver-designs/uni-paver/"><img src="/images/paver-designs/uni-paver.webp" alt="Grey Uni-Paver interlocking concrete block" width="360" height="360" loading="lazy" /><span>Uni-Paver</span><small>View design →</small></a>
    </div>
  </section>
  <section class="content-section dark-band"><p class="eyebrow">Experience Since 1986</p><h2>Personal experience you can build on.</h2><p>Every project has its own requirements. Share your location, intended use and approximate area so we can understand the work involved.</p><a class="button button-primary" href="/get-a-quote/">Start a conversation</a></section>
  <section class="content-section portfolio"><p class="eyebrow">Our Work</p><h2>Project portfolio</h2><p>Explore verified project details and real photographs as they are added.</p><a class="button" href="/projects/">View project portfolio</a></section>
  <section class="content-section contact"><p class="eyebrow">Start a Conversation</p><h2>Tell us about your project.</h2><p>Based in Hyderabad, Sindh · Serving clients across Pakistan</p><div class="actions"><a class="button button-primary" href="https://wa.me/923162753210">WhatsApp: +92 316 2753210</a><a class="button" href="tel:+923162753210">Call Us</a></div><a class="email-link" href="mailto:hellopaverblocks@gmail.com">hellopaverblocks@gmail.com</a></section>
</SiteLayout>

<script>
  const hero = document.querySelector("[data-public-api-base]");
  const configuredApiBase = hero?.dataset.publicApiBase?.trim();

  if (configuredApiBase) {
    try {
      const apiOrigin = new URL(configuredApiBase);
      const isLocalDevelopment = ["localhost", "127.0.0.1"].includes(apiOrigin.hostname);
      if ((apiOrigin.protocol === "https:" || (isLocalDevelopment && apiOrigin.protocol === "http:")) &&
          apiOrigin.pathname === "/" && !apiOrigin.search && !apiOrigin.hash && !apiOrigin.username && !apiOrigin.password) {
        const endpoint = new URL("/api/public/site-settings", apiOrigin.origin);
        const response = await fetch(endpoint, {
          method: "GET",
          mode: "cors",
          credentials: "omit",
          headers: { Accept: "application/json" },
          signal: AbortSignal.timeout(5000)
        });
        if (response.ok) {
          const result = await response.json();
          const data = result && typeof result.data === "object" && result.data !== null ? result.data : {};
          const targets = {
            hero_title: ["homepage-hero-title", 120],
            hero_subtitle: ["homepage-hero-subtitle", 300],
            hero_cta_label: ["homepage-hero-cta", 60],
            about_heading: ["homepage-about-heading", 120],
            about_text: ["homepage-about-text", 2000],
            experience_statement: ["homepage-experience", 180]
          };
          for (const [key, [id, maxLength]] of Object.entries(targets)) {
            const value = data[key];
            const target = document.getElementById(id);
            if (target && typeof value === "string" && value.trim() && value.length <= maxLength) {
              target.textContent = value.trim();
            }
          }
        }
      }
    } catch {
      // Keep the approved static homepage copy if the public API is unavailable.
    }
  }
</script>

<style>
.hero{position:relative;overflow:hidden;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,.65fr);align-items:center;min-height:570px;padding:76px max(8vw,24px);color:white;background:radial-gradient(ellipse at 78% 20%,#294969 0,transparent 42%),#172B45}.hero-content{position:relative;z-index:1;min-width:0}.hero h1{max-width:850px;margin:0 0 22px;font-size:clamp(42px,5.4vw,76px);line-height:1.06;letter-spacing:-.055em}.hero h1 span{color:#F5C542}.hero-copy{max-width:660px;color:#dce4ed;font-size:18px}.hero .eyebrow,.dark-band .eyebrow{color:#F5C542}.experience{margin:24px 0 0;color:#dce4ed;font-size:14px}.experience strong{color:#F5C542}.button-light{color:white;border-color:#8a9aab}.hero-visual{position:relative;width:100%;max-width:500px;min-height:390px;justify-self:end;isolation:isolate}.hero-scene{position:absolute;inset:0;display:grid;place-items:center;opacity:0;animation:heroSceneCycle 25s ease-in-out infinite}.hero-scene:nth-child(1){animation-delay:-2.5s}.hero-scene:nth-child(2){animation-delay:-7.5s}.hero-scene:nth-child(3){animation-delay:-12.5s}.hero-scene:nth-child(4){animation-delay:-17.5s}.hero-scene:nth-child(5){animation-delay:-22.5s}.hero-scene img{display:block;width:100%;height:100%;max-height:390px;object-fit:contain;filter:drop-shadow(0 20px 24px rgba(0,0,0,.22));animation:heroSceneFloat 6s ease-in-out infinite}.hero-scene:nth-child(even) img{animation-delay:-3s}@keyframes heroSceneCycle{0%{opacity:0}2%,16%{opacity:1}20%,100%{opacity:0}}@keyframes heroSceneFloat{0%,100%{transform:translateY(5px)}50%{transform:translateY(-7px)}}.content-section{padding:76px max(8vw,24px)}.content-section h2{max-width:760px;margin-bottom:18px;font-size:clamp(30px,4vw,46px);line-height:1.12;letter-spacing:-.04em}.content-section>p:not(.eyebrow){max-width:760px;color:#667386;font-size:17px}.intro{max-width:1100px}.text-link{display:inline-block;margin-top:12px;color:#8a6500;font-weight:800}.soft-section{background:#f4f6f8}.card-grid{margin:30px 0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.info-card{padding:24px;border:1px solid #e0e5eb;border-radius:10px;background:#fff}.service-index{color:#9b7410;font-size:10px;font-weight:850;letter-spacing:.13em}.info-card h3{margin:14px 0 8px;font-size:19px}.info-card p{color:#667386;font-size:14px}.paver-designs-home{display:grid;grid-template-columns:minmax(250px,.8fr) minmax(0,1.7fr);gap:38px;align-items:center}.designs-intro h2{max-width:520px}.paver-design-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.paver-design-card{min-width:0;overflow:hidden;display:flex;flex-direction:column;border:1px solid #e0e5eb;border-radius:10px;background:#fff;transition:transform .2s ease,box-shadow .2s ease}.paver-design-card:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(23,43,69,.12)}.paver-design-card img{display:block;width:100%;height:clamp(130px,14vw,190px);padding:10px;object-fit:contain;background:#f4f6f8}.paver-design-card span{padding:12px 12px 2px;font-weight:850}.paver-design-card small{padding:0 12px 13px;color:#8a6500;font-weight:800}.dark-band{color:#fff;background:#172B45}.dark-band h2{color:#fff}.dark-band>p:not(.eyebrow){color:#dce4ed}.portfolio{background:#fff}.contact{text-align:center}.contact h2,.contact>p{margin-left:auto;margin-right:auto}.contact .actions{justify-content:center}.email-link{display:inline-block;margin-top:10px;font-weight:800}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:11px 18px;border:1px solid #aab5c1;border-radius:6px;font-weight:750}.button-primary{border-color:transparent;color:#172B45;background:#F5C542}
@media(max-width:900px){.hero{grid-template-columns:1fr;min-height:auto;padding-top:64px;padding-bottom:54px}.hero-visual{justify-self:center;max-width:520px;min-height:clamp(240px,58vw,340px);margin-top:20px}.hero-scene img{max-height:340px}}@media(max-width:760px){.hero{padding-top:56px;padding-bottom:46px}.hero-visual{min-height:clamp(220px,64vw,300px);margin-top:10px}.hero-scene img{max-height:300px}.content-section{padding-top:56px;padding-bottom:56px}.card-grid}@media(prefers-reduced-motion:reduce){.hero-scene{animation:none;opacity:0}.hero-scene:first-child{opacity:1}.hero-scene img{animation:none}}
</style>
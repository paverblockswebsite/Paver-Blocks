---
import SiteLayout from "../layouts/SiteLayout.astro";
const designs = [
  { name: "I-Shape", slug: "i-shape", image: "/images/paver-designs/i-shape-paver.webp", alt: "Grey I-shape interlocking concrete paver block" },
  { name: "Zigzag", slug: "zigzag", image: "/images/paver-designs/zigzag-paver.webp", alt: "Interlocking zigzag concrete paver block" },
  { name: "Rectangular", slug: "rectangular", image: "/images/paver-designs/rectangular-paver.webp", alt: "Rectangular concrete paving blocks in grey, red and charcoal" },
  { name: "Uni-Paver", slug: "uni-paver", image: "/images/paver-designs/uni-paver.webp", alt: "Grey Uni-Paver interlocking concrete block" }
];
---
<SiteLayout title="Paver Block Designs & Options | Paver Blocks Pakistan" description="Explore I-shape, zigzag, rectangular, uni-paver and other paver design options. Product sourcing is coordinated through third-party suppliers." canonical="https://paverblocks.com.pk/paver-designs/">
  <section class="page-hero"><p class="eyebrow">Paver Options</p><h1>Explore paver designs.</h1><p>We help clients identify suitable paver designs and connect with third-party suppliers when product sourcing is required.</p></section>
  <section class="content-section">
    <div class="design-grid">
      {designs.map((design,index)=><a class="design-card" href={`/paver-designs/${design.slug}/`}>
        <img src={design.image} alt={design.alt} width="360" height="360" loading="lazy" />
        <div class="design-card-copy"><p class="eyebrow">Design option 0{index+1}</p><h2>{design.name}</h2><p>Ask us about suitability, available sizes, thicknesses and colours. Availability depends on independent suppliers.</p><span>View design →</span></div>
      </a>)}
      <div class="design-card other-designs"><div class="design-card-copy"><p class="eyebrow">Design option 05</p><h2>Other Designs</h2><p>Have another paver shape in mind? Share a photo or describe the pattern and we can discuss sourcing options with independent suppliers.</p><a href="/get-a-quote/">Ask about another design →</a></div></div>
    </div>
  </section>
  <section class="content-section soft-section"><h2>Not sure which design is suitable?</h2><p>Tell us about the intended use and site conditions. We can discuss options and supplier sourcing where needed.</p><div class="actions"><a class="button button-primary" href="/get-a-quote/">Discuss Your Requirements</a></div></section>
</SiteLayout>
<style>
.design-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.design-card{min-width:0;overflow:hidden;display:grid;grid-template-columns:minmax(160px,.8fr) minmax(0,1.2fr);align-items:center;border:1px solid #e0e5eb;border-radius:12px;background:#fff;transition:transform .2s ease,box-shadow .2s ease}.design-card[href]:hover{transform:translateY(-3px);box-shadow:0 12px 28px rgba(23,43,69,.12)}.design-card img{display:block;width:100%;height:100%;min-height:220px;padding:14px;object-fit:contain;background:#f4f6f8}.design-card-copy{padding:22px}.design-card-copy .eyebrow{margin-bottom:8px}.design-card-copy h2{margin:0 0 8px;font-size:clamp(22px,2.2vw,30px)}.design-card-copy p:not(.eyebrow){margin:0 0 12px;font-size:14px}.design-card-copy span,.design-card-copy>a{color:#8a6500;font-weight:850}.other-designs{display:flex;min-height:220px;background:#f4f6f8}.other-designs .design-card-copy{align-self:center}
@media(max-width:900px){.design-grid{grid-template-columns:1fr}}@media(max-width:600px){.design-card{grid-template-columns:1fr}.design-card img{height:230px;min-height:0}.design-card-copy{padding:18px}}
</style>
---
import SiteLayout from "../../layouts/SiteLayout.astro";
const designs = [
  { name: "I-Shape", slug: "i-shape", image: "/images/paver-designs/i-shape-paver.webp", alt: "Grey I-shape interlocking concrete paver block", description: "The I-shaped profile is designed to interlock with neighbouring units. Ask us about suitability for your site and intended use." },
  { name: "Zigzag", slug: "zigzag", image: "/images/paver-designs/zigzag-paver.webp", alt: "Interlocking zigzag concrete paver block", description: "The zigzag profile creates a repeating interlocking paving pattern. Ask us about suitable applications and supplier options." },
  { name: "Rectangular", slug: "rectangular", image: "/images/paver-designs/rectangular-paver.webp", alt: "Rectangular concrete paving blocks in grey, red and charcoal", description: "Rectangular pavers offer a clean, regular format that can be arranged in different laying patterns. Ask us about available options." },
  { name: "Uni-Paver", slug: "uni-paver", image: "/images/paver-designs/uni-paver.webp", alt: "Grey Uni-Paver interlocking concrete block", description: "Uni-Paver is another interlocking block profile to consider for suitable paving work. Confirm product specifications with the supplier." }
];
export function getStaticPaths() {
  return designs.map((design) => ({ params: { slug: design.slug }, props: { design } }));
}
const { design } = Astro.props;
---
<SiteLayout title={`${design.name} Paver Blocks | Paver Blocks Pakistan`} description={`Explore the ${design.name} paver block shape. Ask Paver Blocks about suitability, available sizes, thicknesses, colours and independent supplier options.`} canonical={`https://paverblocks.com.pk/paver-designs/${design.slug}/`}>
  <section class="page-hero"><p class="eyebrow">Paver Design</p><h1>{design.name} Paver Blocks</h1><p>{design.description}</p></section>
  <section class="content-section design-detail">
    <div class="detail-image"><img src={design.image} alt={design.alt} width="600" height="600" fetchpriority="high" /></div>
    <div class="detail-copy"><p class="eyebrow">Design information</p><h2>Discuss this paver shape for your project.</h2><p>Ask us about suitability, available sizes, thicknesses and colours. Availability and product specifications depend on independent suppliers.</p><p>Paver Blocks focuses on installation and paving-related civil works. When required, we can help connect clients with third-party manufacturers and suppliers; we do not claim to manufacture pavers.</p><div class="actions"><a class="button button-primary" href="/get-a-quote/">Ask about {design.name}</a><a class="button" href="/paver-designs/">Back to all designs</a></div></div>
  </section>
  <section class="content-section soft-section"><h2>Need help choosing?</h2><p>Share the intended use, site location and approximate area. We can discuss the work and help identify suitable product options.</p><a class="button button-primary" href="/get-a-quote/">Discuss Your Requirements</a></section>
</SiteLayout>
<style>
.design-detail{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}.detail-image{display:grid;place-items:center;min-height:360px;padding:24px;border-radius:14px;background:#f4f6f8}.detail-image img{display:block;width:100%;max-width:600px;max-height:520px;object-fit:contain}.detail-copy h2{font-size:clamp(28px,3.4vw,42px);line-height:1.12;letter-spacing:-.04em}.detail-copy p:not(.eyebrow){color:#667386}.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:11px 18px;border:1px solid #aab5c1;border-radius:6px;font-weight:750}.button-primary{border-color:transparent;color:#172B45;background:#F5C542}
@media(max-width:760px){.design-detail{grid-template-columns:1fr;gap:28px}.detail-image{min-height:260px;padding:14px}.detail-image img{max-height:360px}}
</style>
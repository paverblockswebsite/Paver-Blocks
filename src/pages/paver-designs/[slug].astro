---
import SiteLayout from "../../layouts/SiteLayout.astro";
export function getStaticPaths() {
  const designs = [
    { name: "I-Shape", slug: "i-shape", image: "/images/paver-designs/i-shape-paver.webp", alt: "Grey I-shape interlocking concrete paver block", description: "The I-shaped profile is designed to interlock with neighbouring units. Ask us about suitability for your site and intended use." },
    { name: "Zigzag", slug: "zigzag", image: "/images/paver-designs/zigzag-paver.webp", alt: "Interlocking zigzag concrete paver block", description: "The zigzag profile creates a repeating interlocking paving pattern. Ask us about suitable applications and supplier options." },
    { name: "Rectangular", slug: "rectangular", image: "/images/paver-designs/rectangular-paver.jpg", alt: "Rectangular concrete paving blocks in grey, red and charcoal", description: "Rectangular pavers offer a clean, regular format that can be arranged in different laying patterns. Ask us about available options." },
    { name: "Uni-Paver", slug: "uni-paver", image: "/images/paver-designs/uni-paver.jpeg", alt: "Red Uni-Paver interlocking concrete block", description: "Uni-Paver is another interlocking block profile to consider for suitable paving work. Confirm product specifications with the supplier." }
  ];
  return designs.map((design) => ({ params: { slug: design.slug }, props: { design } }));
}
const { design } = Astro.props;
---
<SiteLayout title={`${design.name} Paver Blocks | Paver Blocks Pakistan`} description={`Explore the ${design.name} paver block shape. Ask Paver Blocks about suitability, available sizes, thicknesses, colours and independent supplier options.`} canonical={`https://paverblocks.com.pk/paver-designs/${design.slug}/`}>
  <section class="page-hero"><p class="eyebrow">Paver Design</p><h1>{design.name} Paver Blocks</h1><p>{design.description}</p></section>
  <section class="content-section design-detail">
    <div class="detail-image" data-product-stage>
      <span class="stage-label">Product view <span aria-hidden="true">✦</span></span>
      <div class="detail-image-layers" aria-hidden="true"></div>
      <img src={design.image} alt={design.alt} width="600" height="600" fetchpriority="high" />
      <span class="stage-caption">Original product graphic · proportions preserved</span>
    </div>
    <div class="detail-copy"><p class="eyebrow">Design information</p><h2>Discuss this paver shape for your project.</h2><p>Ask us about suitability, available sizes, thicknesses and colours. Availability and product specifications depend on independent suppliers.</p><p>Paver Blocks focuses on installation and paving-related civil works. When required, we can help connect clients with third-party manufacturers and suppliers; we do not claim to manufacture pavers.</p><div class="actions"><a class="button button-primary" href="/get-a-quote/">Ask about {design.name}</a><a class="button" href="/paver-designs/">Back to all designs</a></div></div>
  </section>
  <section class="content-section soft-section"><h2>Need help choosing?</h2><p>Share the intended use, site location and approximate area. We can discuss the work and help identify suitable product options.</p><a class="button button-primary" href="/get-a-quote/">Discuss Your Requirements</a></section>
</SiteLayout>
<script>
  const productStage = document.querySelector("[data-product-stage]");
  const reduceProductMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (productStage && !reduceProductMotion) {
    const stageObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          productStage.classList.add("is-exploded");
          stageObserver.unobserve(productStage);
        }
      });
    }, { threshold: 0.3 });
    stageObserver.observe(productStage);
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      productStage.addEventListener("pointermove", (event) => {
        const rect = productStage.getBoundingClientRect();
        const x = (event.clientX - rect.left) / rect.width;
        const y = (event.clientY - rect.top) / rect.height;
        productStage.style.setProperty("--stage-rotate-x", `${((0.5 - y) * 5).toFixed(2)}deg`);
        productStage.style.setProperty("--stage-rotate-y", `${((x - 0.5) * 8).toFixed(2)}deg`);
      });
      productStage.addEventListener("pointerleave", () => {
        productStage.style.setProperty("--stage-rotate-x", "0deg");
        productStage.style.setProperty("--stage-rotate-y", "0deg");
      });
    }
  } else if (productStage) {
    productStage.classList.add("is-exploded");
  }
</script>
<style>
.design-detail{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
.detail-image{--stage-rotate-x:0deg;--stage-rotate-y:0deg;position:relative;display:grid;place-items:center;min-height:390px;padding:36px;border:1px solid #e3e8ee;border-radius:16px;background:radial-gradient(ellipse at 50% 42%,#fff 0,#f4f6f8 68%);perspective:1200px;transform:perspective(1200px) rotateX(var(--stage-rotate-x)) rotateY(var(--stage-rotate-y));transform-style:preserve-3d;transition:transform .3s ease,box-shadow .35s ease;isolation:isolate;overflow:hidden}
.detail-image::after{position:absolute;inset:0;z-index:0;content:"";pointer-events:none;background:radial-gradient(circle at 50% 45%,rgba(245,197,66,.16),transparent 58%)}
.stage-label,.stage-caption{position:absolute;z-index:3;left:20px;color:#657386;font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
.stage-label{top:18px}.stage-label span{color:#b18408}.stage-caption{right:20px;bottom:17px;left:auto;font-size:10px;letter-spacing:.04em;text-transform:none}
.detail-image img{position:relative;z-index:2;display:block;width:100%;max-width:600px;max-height:520px;object-fit:contain;transform:translateZ(36px) rotateY(0deg);filter:drop-shadow(0 18px 16px rgba(23,43,69,.15));transition:transform .9s cubic-bezier(.2,.7,.2,1),filter .4s ease}
.detail-image:hover img{transform:translateZ(48px) rotateY(360deg) scale(1.025);filter:drop-shadow(0 24px 20px rgba(23,43,69,.2))}
.detail-image-layers{position:absolute;z-index:1;inset:16% 18%;border:1px solid rgba(23,43,69,.12);border-radius:18px;transform:translate3d(0,0,-30px) rotate(-4deg);opacity:0;transition:transform .85s cubic-bezier(.2,.7,.2,1),opacity .5s ease}
.detail-image-layers::before,.detail-image-layers::after{position:absolute;inset:14px;border:1px solid rgba(23,43,69,.1);border-radius:14px;content:"";transform:translate3d(0,0,-22px) rotate(3deg)}
.detail-image-layers::after{inset:28px;transform:translate3d(0,0,-44px) rotate(-3deg)}
.detail-image.is-exploded .detail-image-layers{transform:translate3d(-12px,8px,-30px) rotate(-4deg);opacity:1}
.detail-image.is-exploded .detail-image-layers::before{transform:translate3d(10px,-8px,-22px) rotate(3deg)}
.detail-image.is-exploded .detail-image-layers::after{transform:translate3d(20px,-16px,-44px) rotate(-3deg)}
.detail-copy h2{font-size:clamp(28px,3.4vw,42px);line-height:1.12;letter-spacing:-.04em}.detail-copy p:not(.eyebrow){color:#667386}
.actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:11px 18px;border:1px solid #aab5c1;border-radius:6px;font-weight:750}.button-primary{border-color:transparent;color:#172B45;background:#F5C542}
@media(max-width:760px){.design-detail{grid-template-columns:1fr;gap:28px}.detail-image{min-height:280px;padding:28px 14px}.detail-image img{max-height:360px}.stage-caption{max-width:65%;text-align:right}}
@media(prefers-reduced-motion:reduce){.detail-image,.detail-image img,.detail-image-layers,.detail-image-layers::before,.detail-image-layers::after{transition:none!important;transform:none!important}.detail-image-layers{opacity:0!important}}
</style>
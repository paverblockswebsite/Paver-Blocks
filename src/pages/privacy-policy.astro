  .policy-bottom p{margin:0;color:#172B45;font-weight:750}
  .policy-bottom .button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:10px 16px;border-radius:6px;background:#F5C542;color:#172B45;font-weight:800}

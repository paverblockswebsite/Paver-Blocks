  .policy-content{padding-top:8px}
  .policy-content h2{margin:34px 0 10px;color:#172B45;font-size:23px;line-height:1.3;letter-spacing:-.02em}
  .policy-content p,.policy-content li{color:#536174;font-size:15px;line-height:1.8}

---
import ServiceDetail from "../../components/ServiceDetail.astro";
import { fetchPublicList } from "../../lib/public-cms.js";
const cmsService = (await fetchPublicList("/api/public/services")).find((service) => service?.slug === "paver-block-installation");
---
<ServiceDetail
  title={cmsService?.title || "Paver Block Installation"}
  image="/images/services/PBI1.webp"
  description={(cmsService?.short_description || "Paver block installation for suitable outdoor spaces, access routes and paved surfaces, planned around the site's conditions and intended use.").slice(0, 300)}
  canonical="https://paverblocks.com.pk/services/paver-block-installation/"
  intro={cmsService?.description || "A paving project starts with understanding where the surface will be used, the approximate area, access, existing ground or surface conditions and the finish expected. These details help establish a realistic scope for installation."}
  approach="Where paver blocks are required, we can also help clients discuss suitable product options and sourcing through independent manufacturers or suppliers. Product availability, dimensions and colours depend on those suppliers; Paver Blocks does not manufacture pavers."
  uses={["Residential driveways and entrances","Walkways and outdoor spaces","Commercial and institutional premises","Suitable access and paved areas"]}
  considerations={["Project location and site access","Approximate length, width or total area","Expected pedestrian or vehicle use","Existing ground or surface condition","Whether paver blocks have already been selected or need to be sourced"]}
/>
